# OpenRouter LLM
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional overrides (defaults shown)
# LLM_MODEL=qwen/qwen3-235b-a22b
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=4096
# KB_FORCE_TFIDF=0

# Pinecone vector database (leave empty to use local FAISS fallback)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=kb-index
PINECONE_NAMESPACE=kb-knowledge-graph

# Neo4j Aura graph database (leave empty to use local NetworkX pickle fallback)
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=your-neo4j-username
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=your-neo4j-database

# Vercel Blob storage (leave empty to use local kb-config/ files)
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token-here
BLOB_STORE_PATH=your-blob-store-id/kb-config
