# =============================================================================
# KB Knowledge Graph Engine — environment variable reference
# =============================================================================
# Copy this file to .env and fill in your values. Never commit .env to git.
# All variables are optional unless marked REQUIRED.

# ---------------------------------------------------------------------------
# OpenRouter (LLM + remote embeddings) — REQUIRED
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3-235b-a22b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Default embedding model (remote ID routed via OpenRouter embeddings API).
# Per-workspace overrides available via the graph-config UI.
EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# Set to 1 to use deterministic TF-IDF offline fallback (useful for testing
# without OpenRouter credits). Leave 0 in production.
KB_FORCE_TFIDF=0

# Optional comma-separated allowlist of model IDs shown to users in the UI.
# Empty = expose full OpenRouter catalog. Example:
# OPENROUTER_ALLOWED_MODELS=anthropic/claude-3-7-sonnet,openai/gpt-4o-mini
OPENROUTER_ALLOWED_MODELS=

# ---------------------------------------------------------------------------
# Memgraph (primary graph store) — REQUIRED
# bolt+ssc:// for TLS; bolt:// for local Docker without TLS
# ---------------------------------------------------------------------------
MEMGRAPH_URI=bolt+ssc://<host>:7687
MEMGRAPH_USERNAME=<username>
MEMGRAPH_PASSWORD=<password>
MEMGRAPH_DATABASE=memgraph

# ---------------------------------------------------------------------------
# Qdrant (primary vector store) — REQUIRED
# ---------------------------------------------------------------------------
QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=<qdrant-api-key>
QDRANT_COLLECTION_NAME=kb-knowledge-graph

# ---------------------------------------------------------------------------
# Neon Postgres — REQUIRED
# Application data: users, workspaces, build_jobs, chat history, billing.
# Use the pooled connection string (ends in -pooler.<region>.aws.neon.tech)
# from Neon dashboard → Connection Details → pooled.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://<user>:<password>@ep-<id>-pooler.<region>.aws.neon.tech/neondb

# ---------------------------------------------------------------------------
# Auth (first-party JWT, HS256) — REQUIRED
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating the secret invalidates every live token at once.
# ---------------------------------------------------------------------------
JWT_SECRET=<48-byte-random-string>
# Optional; all have sensible defaults:
# JWT_ALGORITHM=HS256
# JWT_EXPIRES_MINUTES=43200      # 30 days
# JWT_ISSUER=kb-graph-engine
# PASSWORD_MIN_LENGTH=8

# ---------------------------------------------------------------------------
# CORS — production only
# Comma-separated list of allowed frontend origins (full URL with scheme).
# Leave unset locally for "*" wildcard. In production, set to your frontend
# Render URL (e.g. https://opengraph-frontend.onrender.com).
# ---------------------------------------------------------------------------
# CORS_ALLOW_ORIGINS=https://opengraph-frontend.onrender.com

# ---------------------------------------------------------------------------
# Vercel Blob (durable KB file storage) — REQUIRED
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
BLOB_STORE_PATH=v0-it-support-automation-blob/kb-config

# ---------------------------------------------------------------------------
# Upstash Redis (cross-link cache, model catalog cache) — REQUIRED
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash-token>

# ---------------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------------
# Maximum number of workspaces each user can create (prevents abuse)
MAX_WORKSPACES_PER_USER=25

# ---------------------------------------------------------------------------
# Frontend API base — local dev only
# (In production these are wired via render.yaml fromService)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000
BACKEND_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Alternative graph store: Neo4j Aura (leave blank to use Memgraph)
# ---------------------------------------------------------------------------
# NEO4J_URI=neo4j+s://<id>.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=<password>
# NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# Alternative vector store: Pinecone (leave blank to use Qdrant)
# ---------------------------------------------------------------------------
# PINECONE_API_KEY=pcsk_...
# PINECONE_INDEX_NAME=kb-index
# PINECONE_NAMESPACE=kb-knowledge-graph
