# =============================================================================
# KB Knowledge Graph Engine — environment variable reference
# =============================================================================
# Copy this file to .env and fill in your values. Never commit .env to git.
# All variables are optional unless marked REQUIRED.

# ---------------------------------------------------------------------------
# OpenRouter (LLM + remote embeddings) — REQUIRED
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3-235b-a22b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Default embedding model (remote ID routed via OpenRouter embeddings API).
# Per-workspace overrides available via the graph-config UI.
EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# Set to 1 to use deterministic TF-IDF offline fallback (useful for testing
# without OpenRouter credits). Leave 0 in production.
KB_FORCE_TFIDF=0

# Optional comma-separated allowlist of model IDs shown to users in the UI.
# Empty = expose full OpenRouter catalog. Example:
# OPENROUTER_ALLOWED_MODELS=anthropic/claude-3-7-sonnet,openai/gpt-4o-mini
OPENROUTER_ALLOWED_MODELS=

# ---------------------------------------------------------------------------
# Memgraph (primary graph store) — REQUIRED
# bolt+ssc:// for TLS; bolt:// for local Docker without TLS
# ---------------------------------------------------------------------------
MEMGRAPH_URI=bolt+ssc://<host>:7687
MEMGRAPH_USERNAME=<username>
MEMGRAPH_PASSWORD=<password>
MEMGRAPH_DATABASE=memgraph

# ---------------------------------------------------------------------------
# Qdrant (primary vector store) — REQUIRED
# ---------------------------------------------------------------------------
QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=<qdrant-api-key>
QDRANT_COLLECTION_NAME=kb-knowledge-graph

# 1M-scale mode: one collection shared across all tenants, with
# workspace_id as a payload filter. Leave empty for the default
# per-workspace collection layout. If you set it, set the SAME value on
# every backend + worker — a mismatch means writes and reads land in
# different collections.
# QDRANT_SHARED_COLLECTION=

# ---------------------------------------------------------------------------
# Neon Postgres — REQUIRED
# Application data: users, workspaces, build_jobs, chat history, billing.
# Use the pooled connection string (ends in -pooler.<region>.aws.neon.tech)
# from Neon dashboard → Connection Details → pooled.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://<user>:<password>@ep-<id>-pooler.<region>.aws.neon.tech/neondb

# Connection-pool tuning per FastAPI / worker process. Defaults are safe
# for Neon Launch (~900 direct conns). Raise only if the Neon dashboard
# shows pool-wait saturation under load.
# DB_POOL_SIZE=2
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800         # 30 min — under Neon's idle-kill window
# DB_POOL_TIMEOUT=30

# ---------------------------------------------------------------------------
# Auth (first-party JWT, HS256) — REQUIRED
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating the secret invalidates every live token at once.
# ---------------------------------------------------------------------------
JWT_SECRET=<48-byte-random-string>
# Optional; all have sensible defaults:
# JWT_ALGORITHM=HS256
# JWT_EXPIRES_MINUTES=43200      # 30 days
# JWT_ISSUER=kb-graph-engine
# PASSWORD_MIN_LENGTH=8

# ---------------------------------------------------------------------------
# GitHub OAuth — optional "Sign in with GitHub"
# Leave blank to disable the GitHub button on sign-in / sign-up pages.
# Register an app at https://github.com/settings/applications/new
#
#   Dev callback:  http://localhost:8000/api/v1/auth/github/callback
#   Prod callback: https://<backend-host>/api/v1/auth/github/callback
# ---------------------------------------------------------------------------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Optional — defaults to ${BACKEND_URL}/api/v1/auth/github/callback
# GITHUB_OAUTH_REDIRECT_URI=
# Where to redirect after a successful OAuth exchange (absolute frontend URL).
# FRONTEND_URL=http://localhost:3000
# Optional — defaults to JWT_SECRET. Signs the short-lived OAuth `state` JWT.
# OAUTH_STATE_SECRET=

# ---------------------------------------------------------------------------
# Resend (signup OTP) — REQUIRED for email/password signup.
# Without this, POST /api/v1/auth/signup returns 503. GitHub OAuth signup
# is unaffected. Generate a key at https://resend.com/api-keys and verify
# the sending domain (DKIM/SPF) on the same dashboard.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM=OpenGraph <hey@mail.opengraph.tech>
# Optional — all have sensible defaults.
# OTP_TTL_SECONDS=300          # 5 minutes
# OTP_LENGTH=6
# OTP_MAX_ATTEMPTS=5           # wrong-code submissions before ticket is burned
# OTP_MAX_RESENDS=3            # resend-code clicks before ticket is burned

# ---------------------------------------------------------------------------
# CORS — production only
# Comma-separated list of allowed frontend origins (full URL with scheme).
# Leave unset locally for "*" wildcard. In production, set to your frontend
# Render URL (e.g. https://opengraph-frontend.onrender.com).
# ---------------------------------------------------------------------------
# CORS_ALLOW_ORIGINS=https://opengraph-frontend.onrender.com

# ---------------------------------------------------------------------------
# Vercel Blob (durable KB file storage) — REQUIRED
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
BLOB_STORE_PATH=v0-it-support-automation-blob/kb-config

# ---------------------------------------------------------------------------
# Upstash Redis (cross-link cache, model catalog cache) — REQUIRED
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash-token>

# ---------------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------------
# Maximum number of workspaces each user can create (prevents abuse)
MAX_WORKSPACES_PER_USER=25
# MAX_USER_TEMPLATES_PER_USER=50

# ---------------------------------------------------------------------------
# kb-config seed directory
# ---------------------------------------------------------------------------
# Pin the disk seed so a moved/renamed checkout can't derail builds.
# Defaults: loader searches a set of candidate locations (source-adjacent,
# ancestors of __file__, cwd, ancestors of cwd) and falls back to a
# synthesized minimal DomainProfile if none is found. Explicit wins.
# KB_CONFIG_PATH=/app/kb-config

# ---------------------------------------------------------------------------
# In-proc LRU caches (per backend worker)
# ---------------------------------------------------------------------------
# sub → User and prefix → ApiKeyContext. TTL bounds how long a revoked
# key / updated user can stay active; MAX bounds memory per process.
# USER_CACHE_TTL_SECONDS=300
# USER_CACHE_MAX=8192
# API_KEY_CACHE_TTL_SECONDS=300
# API_KEY_CACHE_MAX=8192

# ---------------------------------------------------------------------------
# Rate limiting (fixed-window, per API key, via Upstash INCR + EXPIRE)
# ---------------------------------------------------------------------------
# Fail-open = cache outage doesn't cascade into user-facing 5xx; set to "1"
# only if strict enforcement during a cache outage is worth the tradeoff.
# RATE_LIMIT_FAIL_CLOSED=0
# Bump this to invalidate every live counter on deploy.
# RATE_LIMIT_VERSION=v1

# ---------------------------------------------------------------------------
# Multi-tenant Cypher guard
# ---------------------------------------------------------------------------
# Asserts every KBNode-touching Cypher binds workspace_id before the
# driver executes it. Disable only to debug a specific false positive.
# GRAPH_FILTER_GUARD=1

# ---------------------------------------------------------------------------
# Build worker tuning (worker mode only)
# ---------------------------------------------------------------------------
# How often the worker pings the DB with "still alive, stage X, pct Y".
# Writes are diff-only; steady-state running doesn't touch the row.
# BUILD_HEARTBEAT_INTERVAL_S=10

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Process mode (for single-binary deploys running src.entrypoint)
# ---------------------------------------------------------------------------
# APP_MODE=api             # "api" or "worker"
# WEB_CONCURRENCY=2        # uvicorn workers per API instance
# PORT=8000                # overridden by the host (Render auto-sets)

# ---------------------------------------------------------------------------
# Frontend API base — local dev only
# (In production these are wired via render.yaml fromService)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000
BACKEND_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Alternative graph store: Neo4j Aura (leave blank to use Memgraph)
# ---------------------------------------------------------------------------
# NEO4J_URI=neo4j+s://<id>.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=<password>
# NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# Alternative vector store: Pinecone (leave blank to use Qdrant)
# ---------------------------------------------------------------------------
# PINECONE_API_KEY=pcsk_...
# PINECONE_INDEX_NAME=kb-index
# PINECONE_NAMESPACE=kb-knowledge-graph
