__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
dist/
build/

# Editor / OS
.cursor/
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Test / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Render plan file (not needed in image)
.cursor/

# Postman collection (not needed at runtime)
postman/

# Frontend: built and deployed as a separate Render service.
frontend/
