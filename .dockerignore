# Virtual environments
.venv/
venv/
env/
ENV/

# Secrets — never bake into the image
.env
.env.*

# Git history
.git/
.gitignore

# Generated graph artifacts — produced per-workspace at runtime on a Render Disk.
data/

# Python caches
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
dist/
build/

# Editor / OS
.cursor/
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Test / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Render plan file (not needed in image)
.cursor/

# Postman collection (not needed at runtime)
postman/

# Frontend: built and deployed as a separate Render service.
frontend/

# SDKs: shipped to PyPI + npm via GitHub Actions, not bundled into the
# backend image. sdks/typescript/node_modules alone is ~85 MB — without
# this line every backend deploy pays that cost in the build context
# transfer.
sdks/

# Alembic: migrations are applied at boot via init_db()'s idempotent
# CREATE ... IF NOT EXISTS block. The alembic/ directory + alembic.ini
# are only needed by operators running `alembic revision --autogenerate`
# locally against a Neon staging DB.
alembic/
alembic.ini

# Plan files, local test checkouts, miscellany.
tests/
*.log
coverage/
.venv312/
.next/

# GitHub Actions workflows — configured in the repo, not shipped in the
# runtime image.
.github/
